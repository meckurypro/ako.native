{
  "expo": {
    "name": "Akọ",
    "slug": "ako",
    "scheme": "ako",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.meckurypro.ako",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "com.meckurypro.ako",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon-foreground.png",
        "backgroundColor": "#0A1915"
      },
      "blockedPermissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-blank.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F4EF",
          "dark": {
            "image": "./assets/images/splash-blank.png",
            "backgroundColor": "#0C0C0B"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Akọ uses the camera to scan event tickets at the door and to take photos you send in chats.",
          "microphonePermission": "Akọ uses the microphone to record voice messages you choose to send.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notifications/notification-icon.png",
          "color": "#3D5A45",
          "defaultChannel": "default",
          "sounds": [
            "./assets/notifications/ako_message.wav",
            "./assets/notifications/ako_activity.wav"
          ]
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Akọ lets you add events and meetings you choose to your calendar.",
          "remindersPermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Akọ uses the microphone to record voice messages you choose to send.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Akọ lets you choose photos and videos from your library to share in posts, chats and projects.",
          "cameraPermission": "Akọ uses the camera to scan event tickets at the door and to take photos you send in chats.",
          "microphonePermission": "Akọ uses the microphone to record voice messages you choose to send."
        }
      ],
      "expo-build-properties",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ],
            "useLegacyPackaging": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ebe5d175-1ab8-47d2-85c8-099e5eea4575",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ebe5d175-1ab8-47d2-85c8-099e5eea4575"
      }
    },
    "owner": "meckury"
  }
}
